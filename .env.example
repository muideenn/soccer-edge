# Copy to .env.local (git-ignored) and fill in. Never commit real keys.
# These are read ONLY by the Python pipeline (server side). They are never bundled into the website.

# API-Football v3 (fixtures, results, odds, injuries, statistics)
SOCCER_API_KEY=your-api-football-key-here
# apisports (dashboard.api-football.com) or rapidapi (rapidapi.com/api-sports/api/api-football)
SOCCER_API_PROVIDER=apisports

# Optional second odds feed: The Odds API v4 (h2h + totals). Leave blank to skip.
ODDS_API_KEY=

# Optional third provider: Sportmonks Football API v3 (fixtures, results, corners stats, odds).
# Free plan covers only 2 leagues (Danish Superliga, Scottish Premiership); top-5 leagues need a paid plan.
SPORTMONKS_API_TOKEN=

# Do NOT create VITE_* or NEXT_PUBLIC_* versions of these: anything with a public prefix is
# embedded in browser code. The web build fails on purpose if such a variable exists.
